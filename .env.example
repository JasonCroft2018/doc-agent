# ============================================================
# DocAgent 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:14b
EMBEDDING_MODEL=bge-m3

# ChromaDB 配置
CHROMA_DB_PATH=./data/chroma_db

# LangFuse 配置（可选，用于可观测性）
# 启动 LangFuse: docker-compose --profile monitoring up -d langfuse
# 然后访问 http://localhost:3000 获取密钥
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# 服务端口
API_PORT=8765
